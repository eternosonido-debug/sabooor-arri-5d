+static int sab_child(int category, int parent, int index, int *total)
+{
+    int count=0, result=-1;
+    for (int i=0; i<SAB_NODE_COUNT; i++)
+        if (sab_nodes[i].category==category && sab_nodes[i].parent==parent)
+        {
+            if (count==index) result=i;
+            count++;
+        }
+    *total=count;
+    return result;
+}
