+CONFIG_INT("sabooor.arri.mode", sabooor_arri_mode, 0);
+CONFIG_INT("sabooor.arri.hdmi", sabooor_arri_hdmi, 1);
+CONFIG_INT("sabooor.arri.guides", sabooor_arri_guides, 0);
+CONFIG_INT("sabooor.arri.shutter.time", sabooor_arri_shutter_time, 0);
+static int sabooor_fonts_ready = 0;
+static int sabooor_label_font = FONT_SMALL;
+static int sabooor_monitor_font = FONT_MED;
+#include "sabooor-arri-draw.h"
+static struct menu_entry sabooor_menu[] = {
+    {
+        .name = "Sabooor ARRI",
+        .priv = &sabooor_arri_mode,
+        .max = 2,
+        .choices = CHOICES("Original", "Monitor", "HOME"),
+        .help = "Visual theme only. HOME becomes Monitor while recording.",
+        .help2 = "Exclusive display. Choose Original for ML instruments.",
+    },
+    {
+        .name = "Sabooor HDMI overlay",
+        .priv = &sabooor_arri_hdmi,
+        .max = 1,
+        .choices = CHOICES("OFF", "ON"),
+        .help = "Show Sabooor theme on Canon HDMI output (when theme enabled).",
+        .help2 = "Canon HDMI signal unchanged. Theme only; no clean HDMI mode.",
+    },
+    {
+        .name = "Sabooor frame guides",
+        .priv = &sabooor_arri_guides,
+        .max = 1,
+        .choices = CHOICES("OFF", "ON"),
+        .help = "White 16:9 frame guide and center cross. Display only.",
+    },
+    {
+        .name = "Sabooor shutter display",
+        .priv = &sabooor_arri_shutter_time,
+        .max = 1,
+        .choices = CHOICES("Angle", "Time"),
+        .help = "Read-only shutter format. Does not change exposure.",
+    }
+};
+static void sabooor_init(void *unused)
+{
+    (void)unused;
+    sabooor_label_font = font_by_name("sabo12", COLOR_WHITE, COLOR_BLACK);
+    sabooor_monitor_font = font_by_name("sabo16b", COLOR_WHITE, COLOR_BLACK);
+    sabooor_fonts_ready = sabooor_label_font != FONT_CANON && sabooor_monitor_font != FONT_CANON;
+    menu_add("Prefs", sabooor_menu, COUNT(sabooor_menu));
+}
+INIT_FUNC(__FILE__, sabooor_init);
+/* Reuse the two loaded DIN-compatible slots; never replace global ML fonts.
+ * All colour, alignment and warning bits from the caller remain intact. */
+int sabooor_arri_menu_font(int original, int compact)
+{
+    if (!SABOOOR_ACTIVE || !sabooor_fonts_ready) return original;
+    int face = compact ? sabooor_label_font : sabooor_monitor_font;
+    return (original & ~FONT_MASK) | (face & FONT_MASK);
+}
+/* All themed drawing goes through lvinfo_display's existing semaphore.
+ * No independent task may paint over the native information bars. */
+extern int sabooor_frame_ratio;
+static volatile int sabooor_dirty = 1;
+void sabooor_arri_invalidate(void) { sabooor_dirty = 1; }
+int sabooor_arri_owns_overlay(void)
+{
+    return sabooor_fonts_ready && SABOOOR_ACTIVE && lv && is_movie_mode() &&
+        liveview_display_idle() && get_global_draw() &&
+        !gui_menu_shown() && !get_halfshutter_pressed() &&
+        lv_dispsize == 1 &&
+        (!ext_monitor_hdmi || sabooor_arri_hdmi) && !EXT_MONITOR_RCA;
+}
+void sabooor_arri_step(void)
+{
+    static struct sabooor_values previous;
+    static int previous_home = -1;
+    int home = sabooor_arri_mode == 2 && !RECORDING;
+    int shutter = get_current_shutter_reciprocal_x1000();
+    struct card_info *card = get_shooting_card();
+    struct sabooor_values v = {
+        .iso = lens_info.iso,
+        .aperture = lens_info.aperture,
+        .kelvin = lens_info.kelvin,
+        .wb_kelvin = lens_info.wb_mode == WB_KELVIN,
+        .fps = fps_get_current_x1000(),
+        .shutter = shutter,
+        .recording = !!RECORDING,
+        .focal = lens_info.focal_len,
+        .battery_bars = battery_level_bars,
+        .free_mb = card ? get_free_space_32k(card)/32 : -1,
+        .clip = card && RECORDING_H264_STARTED ? card->file_number : 0,
+        .wb_mode = lens_info.wb_mode,
+        .guides = sabooor_arri_guides,
+        .frame_ratio = sabooor_frame_ratio,
+        .shutter_time = sabooor_arri_shutter_time,
+        .resolution = video_mode_resolution,
+        .hdmi = !!ext_monitor_hdmi,
+        .codec = RECORDING_RAW ? 2 : RECORDING_H264_STARTED ? 1 : 0
+    };
+    if (!sabooor_dirty && previous_home == home &&
+        memcmp(&previous, &v, sizeof(v)) == 0) return;
+    sabooor_dirty = 0;
+    if (previous_home == 1 && !home) bmp_fill(0, 0, 0, 720, 480);
+    sabooor_draw(&v, home);
+    previous = v;
+    previous_home = home;
+}
+#endif
