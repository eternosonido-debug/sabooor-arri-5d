+        bmp_printf(FONT(FONT_MED,COLOR_CYAN,0),5,0,"Prefs");
+        bmp_printf(FONT(FONT_SMALL,COLOR_WHITE,0),5,29,"SABOOOR ARRI");
+        bmp_fill(COLOR_GRAY(30),36,82,648,38);
+        bmp_fill(COLOR_CYAN,36,82,3,38);
+        bmp_printf(FONT(FONT_MED,COLOR_WHITE,0),48,90,"Sabooor ARRI");
+        bmp_printf(FONT(FONT_MED,COLOR_WHITE,0),540,90,"Monitor");
+        bmp_printf(FONT(FONT_MED,COLOR_WHITE,0),48,140,"Sabooor HDMI overlay");
+        bmp_printf(FONT(FONT_MED,COLOR_WHITE,0),540,140,"ON");
+        bmp_printf(FONT(FONT_SMALL,COLOR_CYAN,0),36,380,"SCHEMATIC MENU PREVIEW / not a camera screenshot");
+        bmp_printf(FONT(FONT_SMALL,COLOR_WHITE,0),36,432,"Visual theme only. HOME becomes Monitor while recording.");
+        return 0;
+    }
