@@ -0,0 +1,34 @@
+"""Rasterize OFL FiraGO into private UI bitmaps, preserving ML font slots.
+Usage: python make-sabooor-menu-font.py directory/containing/FiraGO-TTFs
+"""
+from pathlib import Path
+import sys
+from PIL import Image, ImageDraw, ImageFont
+source=Path(sys.argv[1]);chunks=['/* Generated FiraGO bitmaps, SIL OFL 1.1; see data/fonts/FiraGO-OFL.txt. */']
+for face,name,px,height,stride in [('Regular','regular',24,32,4),('SemiBold','title',24,32,4),('Regular','choice',36,48,6)]:
+ font=ImageFont.truetype(str(source/f'FiraGO-{face}.ttf'),px);widths=[];data=[];offsets=[0]
+ for code in list(range(32,127))+[176]:
+  ch=chr(code);w=max(1,int(font.getlength(ch)+.99));assert w<=stride*8
+  im=Image.new('L',(stride*8,height));ImageDraw.Draw(im).text((0,round(px*.95)),ch,font=font,fill=255,anchor='ls');widths.append(w)
+  raw=[]
+  for y in range(height):
+   for b in range(stride):raw.append(sum(1<<x for x in range(8) if im.getpixel((b*8+x,y))>=100))
+  packed=[];i=0
+  while i<len(raw):
+   zero=raw[i]==0;j=i
+   while j<len(raw) and (raw[j]==0)==zero and j-i<128:j+=1
+   packed.append((128 if zero else 0)+(j-i-1))
+   if not zero:packed.extend(raw[i:j])
+   i=j
+  decoded=[];i=0
+  while i<len(packed):
+   token=packed[i];i+=1;n=(token&127)+1
+   if token&128:decoded.extend([0]*n)
+   else:decoded.extend(packed[i:i+n]);i+=n
+  assert decoded==raw
+  data.extend(packed);offsets.append(len(data))
+ assert len(data)<65536
+ print(name,'compressed bytes',len(data),'raw',96*height*stride)
+ chunks += [f'static const unsigned char sab_{name}_widths[96] = {{'+','.join(map(str,widths))+'};',f'static const unsigned short sab_{name}_offsets[97] = {{'+','.join(map(str,offsets))+'};',f'static const unsigned char sab_{name}_bits[{len(data)}] = {{'+','.join(map(str,data))+'};']
+
+(Path(__file__).resolve().parents[1]/'src/sabooor-menu-font.h').write_text('\n'.join(chunks)+'\n')
diff --git a/tools/make-sabooor-public-fonts.py b/tools/make-sabooor-public-fonts.py
new file mode 100644
index 0000000..bd0637e
--- /dev/null
+++ b/tools/make-sabooor-public-fonts.py
@@ -0,0 +1,39 @@
+"""Build redistributable monitor RBFs from the existing OFL FiraGO UI bitmaps.
+Usage: python tools/make-sabooor-public-fonts.py output-directory
+Does not read or overwrite local DIN fonts.
+"""
+from pathlib import Path
+import re,struct,sys
+from PIL import Image
+root=Path(__file__).resolve().parents[1]
+s=(root/'src/sabooor-menu-font.h').read_text();out=Path(sys.argv[1]);out.mkdir(parents=True,exist_ok=True)
+def arr(name):return list(map(int,re.search(r'\b'+name+r'\[\d+\] = \{([^}]+)',s)[1].split(',')))
+for face,px,name in [('regular',12,'sabo12'),('title',16,'sabo16b')]:
+ widths=arr('sab_'+face+'_widths');offsets=arr('sab_'+face+'_offsets');packed=arr('sab_'+face+'_bits')
+ wmax=24;stride=wmax//8;data=bytearray();ws=[]
+ for code in range(32,132):
+  idx=code-32 if code<127 else 95 if code==131 else None
+  if idx is None:ws.append(1);data.extend(bytes(stride*px));continue
+  raw=[];i=offsets[idx]
+  while i<offsets[idx+1]:
+   t=packed[i];i+=1;n=(t&127)+1
+   if t&128:raw.extend([0]*n)
+   else:raw.extend(packed[i:i+n]);i+=n
+  assert len(raw)==128
+  im=Image.new('L',(widths[idx],32))
+  for y in range(32):
+   for x in range(widths[idx]):
+    if raw[y*4+x//8]&(1<<(x%8)):im.putpixel((x,y),255)
+  w=max(1,round(widths[idx]*px/24));assert w<=wmax
+  im=im.resize((w,px),Image.Resampling.LANCZOS);ws.append(w)
+  glyph=bytearray(stride*px)
+  for y in range(px):
+   for x in range(w):
+    if im.getpixel((x,y))>=100:glyph[y*stride+x//8]|=1<<(x%8)
+  data.extend(glyph)
+ # Same RBF format as the upstream fonts; ASCII 131 is the monitor degree glyph.
+ magic=(root/'data/fonts/argnor23.rbf').read_bytes()[:8]
+ h=magic+name.encode().ljust(64,b'\0')+struct.pack('<11i',stride*px,px,px,wmax,32,131,0,116,216,2,px)
+ (out/(name+'.rbf')).write_bytes(h+bytes(ws)+data)
+(out/'FiraGO-OFL.txt').write_bytes((root/'data/fonts/FiraGO-OFL.txt').read_bytes())
+print('OFL FiraGO monitor fonts generated; no DIN files copied.')
