diff --git a/src/sabooor-arri-draw.h b/src/sabooor-arri-draw.h
new file mode 100644
index 0000000..44ba21f
--- /dev/null
+++ b/src/sabooor-arri-draw.h
@@ -0,0 +1,116 @@
+/* GPL-2.0-or-later. ALEXA Mini SUP 5.3 pp.39,75 visual reference.
+ * Canon data and unavailable fields are labelled honestly. 720x480 canvas. */
+struct sabooor_values {
+    int iso, aperture, kelvin, wb_kelvin, fps, shutter, recording;
+    int focal, battery_bars, free_mb, clip, wb_mode;
+    int guides, shutter_time, resolution, hdmi, codec;
+    int frame_ratio;
+};
+static void sabooor_text(int font, int fg, int bg, int x, int y, const char *text)
+{ bmp_printf(FONT(font,fg,bg),x,y,"%s",text); }
+static const char *sabooor_wb(int mode)
+{
+    switch(mode) { case 0:return "AWB";case 1:return "DAY";case 2:return "CLOUD";
+    case 3:return "TUNG";case 4:return "FLUOR";case 5:return "FLASH";
+    case 6:return "CUSTOM";case 8:return "SHADE";default:return "--"; }
+}
+static void sabooor_home_cell(int x,int y,const char *label,const char *value)
+{
+    bmp_fill(COLOR_BLACK,x,y,194,20);
+    sabooor_text(sabooor_label_font,COLOR_WHITE,COLOR_BLACK,x+8,y+3,label);
+    sabooor_text(FONT_LARGE,COLOR_BLACK,COLOR_WHITE,x+8,y+25,value);
+}
+static void sabooor_draw(const struct sabooor_values *v, int home)
+{
+    char fps[20],shutter[20],iris[20],iso[20],wb[20],focal[20],bat[20],card[20],clip[20];
+    home=home&&!v->recording;
+    if(v->fps>0)snprintf(fps,sizeof(fps),"%d.%03d",v->fps/1000,v->fps%1000);
+    else snprintf(fps,sizeof(fps),"--");
+    /* fps is x1000; shutter is reciprocal x1000. Angle is in tenths. */
+    if(v->shutter>0&&v->shutter<100000000&&v->fps>0) {
+        int a=(v->fps*3600+v->shutter/2)/v->shutter;
+        snprintf(shutter,sizeof(shutter),"%d.%d\x83",a/10,a%10);
+    } else snprintf(shutter,sizeof(shutter),"--");
+    if(v->shutter_time && v->shutter>0 && v->shutter<100000000) {
+        if(v->shutter>=1000)snprintf(shutter,sizeof(shutter),"1/%d",(v->shutter+500)/1000);
+        else snprintf(shutter,sizeof(shutter),"%d.%ds",1000/v->shutter,(10000/v->shutter)%10);
+    }
+    if(v->aperture>0)snprintf(iris,sizeof(iris),"f/%d.%d",v->aperture/10,v->aperture%10);
+    else snprintf(iris,sizeof(iris),"--");
+    if(v->iso>0)snprintf(iso,sizeof(iso),"%d",v->iso);else snprintf(iso,sizeof(iso),"AUTO");
+    if(v->wb_kelvin)snprintf(wb,sizeof(wb),"%dK",v->kelvin);
+    else snprintf(wb,sizeof(wb),"%s",sabooor_wb(v->wb_mode));
+    if(v->focal>0)snprintf(focal,sizeof(focal),"%dmm",v->focal);else snprintf(focal,sizeof(focal),"--");
+    if(v->battery_bars>=0)snprintf(bat,sizeof(bat),"%s",v->battery_bars==0?"LOW":v->battery_bars==1?"MID":"HIGH");else snprintf(bat,sizeof(bat),"--");
+    if(v->free_mb>=0)snprintf(card,sizeof(card),"%d.%dGB",v->free_mb/1024,(v->free_mb%1024)*10/1024);
+    else snprintf(card,sizeof(card),"--");
+    if(v->clip>0)snprintf(clip,sizeof(clip),"MVI_%04d",v->clip);else snprintf(clip,sizeof(clip),"--");
+    if(home) {
+        bmp_fill(COLOR_BLACK,0,0,720,480);
+        bmp_fill(COLOR_WHITE,48,0,672,100);
+        bmp_fill(COLOR_WHITE,48,380,672,100);
+        sabooor_home_cell(60,6,"FPS",fps);
+        sabooor_home_cell(282,6,"TC","--:--:--:--");
+        sabooor_home_cell(504,6,v->shutter_time?"SHUTTER / time":"SHUTTER / deg",shutter);
+        sabooor_home_cell(60,385,"ISO",iso);
+        sabooor_home_cell(282,385,"LOOK","--");
+        sabooor_home_cell(504,385,"WB",wb);
+        sabooor_text(sabooor_label_font,COLOR_WHITE,COLOR_BLACK,5,190,"MENU");
+        sabooor_text(FONT_MED,COLOR_WHITE,COLOR_BLACK,76,130,SABOOOR_MODEL " / " SABOOOR_FIRMWARE);
+        sabooor_text(sabooor_label_font,COLOR_WHITE,COLOR_BLACK,76,166,"SABOOOR ARRI / HOME");
+        sabooor_text(FONT_LARGE,v->recording?COLOR_RED:COLOR_GREEN1,COLOR_BLACK,540,240,v->recording?"REC":"STBY");
+        sabooor_text(sabooor_monitor_font,COLOR_WHITE,COLOR_BLACK,300,275,"CLIP");
+        sabooor_text(sabooor_monitor_font,COLOR_WHITE,COLOR_BLACK,354,275,clip);
+        sabooor_text(sabooor_label_font,COLOR_WHITE,COLOR_BLACK,76,344,"BAT");
+        sabooor_text(sabooor_monitor_font,COLOR_WHITE,COLOR_BLACK,104,341,bat);
+        sabooor_text(sabooor_label_font,COLOR_WHITE,COLOR_BLACK,550,344,"CARD");
+        sabooor_text(sabooor_monitor_font,COLOR_WHITE,COLOR_BLACK,590,341,card);
+        sabooor_text(sabooor_label_font,COLOR_BLACK,COLOR_WHITE,68,460,iris);
+        sabooor_text(sabooor_label_font,COLOR_BLACK,COLOR_WHITE,156,460,"ND --");
+        return;
+    }
+    /* Match user CCM-1 references: a narrow left rail and compact status rows.
+     * Labels: regular sans 12px gray. Values: semibold sans 16px white. */
+    bmp_fill(COLOR_BLACK,0,0,720,44);
+    bmp_fill(COLOR_BLACK,0,436,720,44);
+    bmp_fill(COLOR_BLACK,0,44,32,392);
+    #define SAB_LABEL(x,y,t) sabooor_text(sabooor_label_font,COLOR_GRAY(70),COLOR_BLACK,x,y,t)
+    #define SAB_VALUE(x,y,t) sabooor_text(sabooor_monitor_font,COLOR_WHITE,COLOR_BLACK,x,y,t)
+    SAB_LABEL(35,26,"FPS");SAB_VALUE(61,22,fps);
+    SAB_LABEL(128,26,"SHUTTER");SAB_VALUE(183,22,shutter);
+    SAB_LABEL(246,26,"IRIS");SAB_VALUE(275,22,iris);
+    SAB_LABEL(352,26,"ISO");SAB_VALUE(378,22,iso);
+    SAB_LABEL(442,26,"ND");SAB_VALUE(465,22,"--");
+    SAB_LABEL(510,26,"WB");SAB_VALUE(538,22,wb);
+    /* A Canon G/M shift is not an ARRI CC measurement: leave that space clear. */
+    SAB_LABEL(2,50,v->hdmi?"HDMI":"LCD");
+    SAB_LABEL(2,212,"CAM");
+    bmp_fill(COLOR_GRAY(70),1,229,30,19);
+    sabooor_text(sabooor_label_font,COLOR_BLACK,COLOR_GRAY(70),3,233,
+        v->resolution==0?"FHD":v->resolution==1?"HD":"VGA");
+    bmp_fill(COLOR_GRAY(70),1,251,30,19);
+    sabooor_text(sabooor_label_font,COLOR_BLACK,COLOR_GRAY(70),2,255,
+        v->codec==2?"RAW":v->codec==1?"H264":"--");
+    SAB_LABEL(35,447,"FCL");SAB_VALUE(59,443,focal);
+    SAB_LABEL(134,447,"BAT");SAB_VALUE(162,443,bat);
+    SAB_LABEL(227,447,"CLIP");SAB_VALUE(260,443,clip);
+    {
+        int tally=v->recording?COLOR_RED:COLOR_GREEN1;
+        bmp_fill(tally,365,444,3,1);bmp_fill(tally,363,445,7,1);
+        bmp_fill(tally,362,446,9,5);bmp_fill(tally,363,451,7,1);
+        bmp_fill(tally,365,452,3,1);
+    }
+    sabooor_text(sabooor_monitor_font,v->recording?COLOR_RED:COLOR_GREEN1,COLOR_BLACK,376,443,v->recording?"REC":"STBY");
+    SAB_LABEL(465,447,"CARD");SAB_VALUE(503,443,card);
+    SAB_LABEL(601,447,"TC");SAB_LABEL(624,447,"--:--:--:--");
+    if(v->guides) {
+        int w=644,h=362;
+        if(v->frame_ratio==1)h=274;
+        else if(v->frame_ratio==2)w=362;
+        else if(v->frame_ratio==3)w=204;
+        bmp_draw_rect(COLOR_WHITE,376-w/2,241-h/2,w,h);
+        bmp_fill(COLOR_WHITE,371,241,11,1);bmp_fill(COLOR_WHITE,376,236,1,11);
+    }
+    #undef SAB_LABEL
+    #undef SAB_VALUE
+}
