index 0000000..3f49793
--- /dev/null
+++ b/tools/make-sabooor-fonts.py
@@ -0,0 +1,28 @@
+"""Derive compact RBF sizes from ML argnor23 (no proprietary ARRI font)."""
+from pathlib import Path
+import struct
+from PIL import Image, ImageChops
+root=Path(__file__).resolve().parents[1]
+b=(root/'data/fonts/argnor23.rbf').read_bytes();h=struct.unpack_from('<11i',b,72)
+size,points,height,width,first,last,unk,wo,co,desc,line=h
+for target,name in [(12,'sabo12'),(16,'sabo16b')]:
+ scale=target/height;newwidth=((round(width*scale)+7)//8)*8;stride=newwidth//8
+ widths=[];data=bytearray()
+ for code in range(first,last+1):
+  cw=b[wo+code-first];nw=max(1,round(cw*scale));widths.append(nw)
+  im=Image.new('L',(cw,height),0);base=co+(code-first)*size
+  for y in range(height):
+   for x in range(cw):
+    if b[base+y*(size//height)+x//8]&(1<<(x%8)):im.putpixel((x,y),255)
+  im=im.resize((nw,target),Image.Resampling.LANCZOS)
+  if name.endswith('b'):
+   shifted=Image.new('L',im.size,0);shifted.paste(im,(1,0));im=ImageChops.lighter(im,shifted)
+  char=bytearray(stride*target)
+  for y in range(target):
+   for x in range(nw):
+    if im.getpixel((x,y))>=100:char[y*stride+x//8]|=1<<(x%8)
+  data+=char
+ woff=116;coff=woff+len(widths)
+ header=b[:8]+name.encode().ljust(64,b'\0')+struct.pack('<11i',stride*target,target,target,newwidth,first,last,0,woff,coff,round(desc*scale),round(line*scale))
+ (root/'data/fonts'/f'{name}.rbf').write_bytes(header+bytes(widths)+data)
+ print(name,target,'px')
diff --git a/tools/make-sabooor-fuji.py b/tools/make-sabooor-fuji.py
