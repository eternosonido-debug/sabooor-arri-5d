+static struct menu *sab_entry_owner(struct menu_entry *entry)
+{
+    for (struct menu *m=menus; m; m=m->next)
+        for (struct menu_entry *e=m->children; e; e=e->next)
+            if (e==entry) return m;
+    return 0;
+}
+
+/* Reconstruct native selection ancestry only when invoking a real ML setter.
+ * The presentation tree never relinks or duplicates any ML entry. */
+static int sab_bind_select(struct menu_entry *entry)
+{
+    struct menu_entry *chain[8]; int count=0;
+    for (struct menu_entry *e=entry; e; e=e->parent)
+    {
+        if (count==8) return 0;
+        chain[count++]=e;
+    }
+    if (!count) return 0;
+    struct menu *top=sab_entry_owner(chain[count-1]);
+    if (!top || IS_SUBMENU(top)) return 0;
+    for (struct menu *m=menus; m; m=m->next)
+        if (!IS_SUBMENU(m)) m->selected=(m==top);
+    for (int i=count-1; i>=0; i--)
+    {
+        struct menu *owner=sab_entry_owner(chain[i]);
+        if (!owner) return 0;
+        for (struct menu_entry *e=owner->children; e; e=e->next)
+            e->selected=(e==chain[i]);
+    }
+    menu_first_by_icon=top->icon;
+    submenu_level=count-1;
+    return 1;
+}
