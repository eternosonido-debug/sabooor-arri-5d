+static int sab_text_width(const char *s, int face)
+{
+    const unsigned char *widths=face==2?sab_choice_widths:
+        face==1?sab_title_widths:sab_regular_widths;
+    int width=0;
+    if (s) for (; *s; s++)
+    {
+        unsigned c=(unsigned char)*s;
+        if (c==194 && (unsigned char)s[1]==176) { c=176; s++; }
+        if (c==131 || c==176) c=127;
+        else if (c<32 || c>126) c='?';
+        width+=widths[c-32];
+    }
+    return width;
+}
+
+static void sab_text(int x, int y, int right, int color, const char *s, int face)
+{
+    const unsigned char *widths=face==2?sab_choice_widths:
+        face==1?sab_title_widths:sab_regular_widths;
+    const unsigned char *bits=face==2?sab_choice_bits:
+        face==1?sab_title_bits:sab_regular_bits;
+    const unsigned short *offsets=face==2?sab_choice_offsets:
+        face==1?sab_title_offsets:sab_regular_offsets;
+    int stride=face==2?6:4, height=face==2?48:32;
+    if (!s) return;
+    for (; *s; s++)
+    {
+        unsigned c=(unsigned char)*s;
+        if (c==194 && (unsigned char)s[1]==176) { c=176; s++; }
+        if (c==131 || c==176) c=127;
+        else if (c<32 || c>126) c='?';
+        c-=32;
+        int w=widths[c];
+        if (x+w>right) break;
+        unsigned char glyph[288];
+        int in=offsets[c], end=offsets[c+1], out=0;
+        while (in<end && out<stride*height)
+        {
+            unsigned token=bits[in++], count=(token&127)+1;
+            if (count>(unsigned)(stride*height-out)) return;
+            if (token&128) { memset(glyph+out,0,count); out+=count; }
+            else
+            {
+                if (in+(int)count>end) return;
+                memcpy(glyph+out,bits+in,count); in+=count; out+=count;
+            }
+        }
+        if (out!=stride*height) return;
+
+        for (int py=0; py<height; py++)
+            for (int px=0; px<stride*8; px++)
+                if (x+px<right && y+py<480 &&
+                    (glyph[py*stride+px/8]&(1<<(px%8))))
+                    bmp_putpixel(x+px,y+py,color);
+        x+=w;
+    }
+}
+
+static void sab_center(int y, int color, const char *text, int face)
+{
+    int w=MIN(680,sab_text_width(text,face));
+    sab_text((720-w)/2,y,700,color,text,face);
+}
+
+static int sab_can_stage(struct menu_entry *e)
+{
+    /* Never bypass hardware setters, actions, caret editors or LiveView hooks. */
+    return e && (!e->select || sabooor_camera_staged(e)) && !e->select_Q && !IS_ACTION(e) &&
+        IS_ML_PTR(e->priv) && e->max>e->min &&
+        e->max-e->min<64 && (e->choices || IS_BOOL(e)) &&
+        !(e->edit_mode & EM_SHOW_LIVEVIEW);
+}
+
+static int sab_choice_allowed(struct menu_entry *e, int value)
+{
+    return value>=e->min && value<=e->max && sabooor_camera_allowed(e,value) &&
+        (!e->choices || !strstr(e->choices[value-e->min],"N/A"));
+}
+
+static void sab_choice_move(int delta)
+{
+    struct menu_entry *e=sab_choice_entry;
+    for (int v=sab_choice_value+delta; v>=e->min && v<=e->max; v+=delta)
+        if (sab_choice_allowed(e,v)) { sab_choice_value=v; break; }
+}
+
+static void sab_choice_label(struct menu_entry *e, int v, char *buf, int size)
+{
+    if (e->choices) snprintf(buf,size,"%s",e->choices[v-e->min]);
+    else snprintf(buf,size,"%s",v?"ON":"OFF");
+}
+
+static int sab_choice_present(void)
+{
+    /* Do not dereference a stale module-owned entry after unloading a module. */
+    for (struct menu *m=menus; m; m=m->next)
+        for (struct menu_entry *e=m->children; e; e=e->next)
+            if (e==sab_choice_entry) return 1;
+    return 0;
+}
+
+static void sab_draw_choice(void)
+{
+    struct menu_entry *e=sab_choice_entry;
+    bmp_fill(COLOR_WHITE,0,0,720,480);
+    bmp_fill(COLOR_GRAY(15),0,0,720,60);
+    sab_center(16,COLOR_WHITE,sab_choice_node>=0?sab_node_label(&sab_nodes[sab_choice_node]):e->name,0);
+    int values[64], count=0, position=0;
+    for (int v=e->min; v<=e->max && count<64; v++)
+        if (sab_choice_allowed(e,v))
+        {
+            if (v==sab_choice_value) position=count;
+            values[count++]=v;
+        }
+    int start=MIN(MAX(0,position-2),MAX(0,count-4));
+    for (int row=start; row<count && row<start+4; row++)
+    {
+        int v=values[row], y=60+(row-start)*80, selected=(v==sab_choice_value);
+        char label[MENU_MAX_VALUE_LEN];
+        sab_choice_label(e,v,label,sizeof(label));
+        if (selected) bmp_fill(COLOR_BLUE,60,y,600,80);
+        sab_text(80,y+16,648,selected?COLOR_WHITE:COLOR_GRAY(15),label,2);
+    }
+    bmp_fill(COLOR_GRAY(15),0,420,720,60);
+    bmp_draw_rect(COLOR_GRAY(65),60,428,150,48);
+    bmp_draw_rect(COLOR_GRAY(65),510,428,150,48);
+    sab_text(75,438,205,COLOR_WHITE,"Q: cancel",0);
+    sab_text(526,438,655,COLOR_WHITE,"SET: set",0);
+}
