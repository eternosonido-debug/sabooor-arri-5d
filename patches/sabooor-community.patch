+    if(mode==3) {v.iso=0;v.aperture=0;v.wb_kelvin=0;v.shutter=0;v.fps=0;v.wb_mode=0;}
+    if(mode==7){v.iso=12800;v.aperture=220;v.kelvin=12000;v.fps=59940;v.shutter=125000;v.focal=600;v.free_mb=32768;v.clip=9999;v.recording=1;}
