+/* Read the active Canon/ML state. Readouts never masquerade as selectors. */
+static int sab_readout(int provider, char *text, int size)
+{
+    int v=0;
+    switch (provider)
+    {
+        case 1: snprintf(text,size,"%s",RECORDING_RAW?"RAW (ML)":"H.264 / MOV"); break;
+        case 2: snprintf(text,size,"%s",video_mode_crop?SABOOOR_SENSOR " / crop":SABOOOR_SENSOR); break;
+        case 3:
+            if (RECORDING_RAW) { snprintf(text,size,"RAW (module)"); break; }
+            snprintf(text,size,"%s",video_mode_resolution==0?"1920x1080":
+                video_mode_resolution==1?"1280x720":video_mode_resolution==2?"640x480":"--"); break;
+        case 4:
+            if (RECORDING_RAW) { snprintf(text,size,"RAW (module)"); break; }
+            v=video_mode_fps;
+            if (v==24 || v==30 || v==60) v=v*1000000/1001;
+            else v*=1000;
+            if (v>0) snprintf(text,size,"%d.%03d",v/1000,v%1000);
+            else snprintf(text,size,"--");
+            break;
+        case 5: snprintf(text,size,"%s",sound_recording_enabled()?"ON":"OFF"); break;
+        case 6: snprintf(text,size,SABOOOR_MODEL " / " SABOOOR_FIRMWARE); break;
+        case 7: snprintf(text,size,SABOOOR_MODEL); break;
+        case 8:
+        {
+            struct card_info *card=get_shooting_card();
+            v=card?get_free_space_32k(card)/32:-1;
+            if (v>=0) snprintf(text,size,"%d.%d GB free",v/1024,(v%1024)*10/1024);
+            else snprintf(text,size,"No card");
+            break;
+        }
+        case 9: snprintf(text,size,"%s",lens_info.name[0]?lens_info.name:"--"); break;
+        case 10:
+            v=fps_get_current_x1000();
+            if (v>0) snprintf(text,size,"%d.%03d",v/1000,v%1000);
+            else snprintf(text,size,"--");
+            break;
+        case 12: snprintf(text,size,"A"); break;
+        case 13: snprintf(text,size,"Canon default"); break;
+        case 11:
+            v=get_current_shutter_reciprocal_x1000();
+            if (v>=1000 && v<100000000) snprintf(text,size,"1/%d s",(v+500)/1000);
+            else if (v>0 && v<1000) snprintf(text,size,"%d.%d s",1000/v,(10000/v)%10);
+            else snprintf(text,size,"--");
+            break;
+        default: return 0;
+    }
+    return 1;
+}
