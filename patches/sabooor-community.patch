diff --git a/src/sabooor-camera.c b/src/sabooor-camera.c
new file mode 100644
index 0000000..1cd6764
--- /dev/null
+++ b/src/sabooor-camera.c
@@ -0,0 +1,214 @@
+/* GPL-2.0-or-later. Native controls and a preview-only Fuji LUT processor. */
+#include "dryos.h"
+#include "bmp.h"
+#include "menu.h"
+#include "config.h"
+#include "property.h"
+#include "propvalues.h"
+#include "gui.h"
+#include "zebra.h"
+#include "vram.h"
+#include "fio-ml.h"
+#include "sabooor-arri.h"
+#include "sabooor-camera.h"
+#if SABOOOR_SUPPORTED
+static int camera_video_length,camera_standard_length,camera_zoom_length;
+static int camera_mode[5];
+PROP_HANDLER(PROP_VIDEO_MODE)
+{
+    camera_video_length=len;
+    if(len==sizeof(camera_mode))memcpy(camera_mode,buf,sizeof(camera_mode));
+}
+PROP_HANDLER(PROP_VIDEO_SYSTEM){camera_standard_length=len;}
+PROP_HANDLER(PROP_LV_DISPSIZE){camera_zoom_length=len;}
+static int resolution_choice,rate_choice,zoom_choice;
+static volatile int camera_pending;
+static int camera_pending_kind,camera_pending_value;
+CONFIG_INT("sabooor.film",sabooor_film,0);
+CONFIG_INT("sabooor.film.strength",sabooor_film_strength,4);
+CONFIG_INT("sabooor.frame.ratio",sabooor_frame_ratio,0);
+CONFIG_INT("sabooor.reel.next",sabooor_reel_next,1);
+static unsigned *film_lut;
+static int film_loaded,film_error;
+#include "sabooor-film-render.h"
+static void camera_select(void *priv,int delta);
+#if SABOOOR_NATIVE_VIDEO_MENU
+static void canon_video_task(void *unused)
+{
+    if(RECORDING)return;
+    gui_stop_menu();msleep(300);
+    if(RECORDING)return;
+    SetGUIRequestMode(1);
+    NotifyBox(10000,"Canon MENU > Movie rec. size\nChoose resolution, frame rate and ALL-I/IPB here.");
+}
+static MENU_SELECT_FUNC(canon_video_open)
+{
+    if(!RECORDING)task_create("sab_canon_video",0x1c,0x2000,canon_video_task,0);
+}
+#endif
+
+static const int camera_rates[]={24,24,30,30,60};
+static int rate_index(int f){return f==24?0:f==30?2:f==60?4:-1;}
+static int valid_rate(int res,int index){if(index<0||index>4)return 0;int fps=camera_rates[index];return res==0?fps==24||fps==30:res==1?fps==60:res==2?fps==30:0;}
+static MENU_UPDATE_FUNC(camera_display)
+{
+    zoom_choice=lv_dispsize==10?2:lv_dispsize==5?1:0;
+    resolution_choice=video_mode_resolution;
+    if(rate_choice<0||rate_choice>4||camera_rates[rate_choice]!=video_mode_fps)
+        rate_choice=COERCE(rate_index(video_mode_fps),0,4);
+    if(entry->priv==&zoom_choice)MENU_SET_VALUE("%s",entry->choices[zoom_choice]);
+    else if(entry->priv==&resolution_choice)
+    {
+        if(resolution_choice>=0&&resolution_choice<=2)MENU_SET_VALUE("%s",entry->choices[resolution_choice]);
+        else MENU_SET_VALUE("--");
+    }
+    else if(video_system_pal && !SABOOOR_NATIVE_VIDEO_MENU)MENU_SET_VALUE("Set Canon NTSC");
+    else if(SABOOOR_NATIVE_VIDEO_MENU && video_system_pal)MENU_SET_VALUE("%d.000",video_mode_fps);
+    else if(rate_index(video_mode_fps)>=0)MENU_SET_VALUE("%s",entry->choices[rate_choice]);
+    else MENU_SET_VALUE("--");
+    if(camera_pending)MENU_SET_WARNING(MENU_WARN_NOT_WORKING,"Video change pending. Wait for the Canon screen.");
+    else if(RECORDING)MENU_SET_WARNING(MENU_WARN_NOT_WORKING,"Stop recording to change video mode.");
+    else if(get_config_var("fps.override"))MENU_SET_WARNING(MENU_WARN_NOT_WORKING,"Disable ML FPS override before changing Canon mode.");
+    else if(video_system_pal && !SABOOOR_NATIVE_VIDEO_MENU && entry->priv!=&zoom_choice)MENU_SET_WARNING(MENU_WARN_NOT_WORKING,"Select NTSC in Canon MENU > Video system first.");
+    else if(SABOOOR_NATIVE_VIDEO_MENU && entry->priv!=&zoom_choice)MENU_SET_WARNING(MENU_WARN_ADVICE,"SET: Canon Movie rec. size. Native control; no 600D setter.");
+    else if(entry->priv==&rate_choice)MENU_SET_WARNING(MENU_WARN_ADVICE,"24/30 are aliases for 23.976/29.97. 59.94 changes resolution to 720p.");
+}
+int sabooor_camera_staged(struct menu_entry *e){return e && e->select==camera_select;}
+int sabooor_camera_allowed(struct menu_entry *e,int v)
+{
+    if(!sabooor_camera_staged(e))return 1;
+    if(e->priv==&resolution_choice||e->priv==&zoom_choice)return v>=0&&v<=2;
+    if(e->priv!=&rate_choice)return 0;
+    return v>=0&&v<=4;
+}
+static int camera_apply(struct menu_entry *e,int value)
+{
+    if(!sabooor_camera_staged(e)||!sabooor_camera_allowed(e,value)||RECORDING||!is_movie_mode()||get_config_var("fps.override"))return 0;
+    if(e->priv==&zoom_choice)
+    {
+        if(!lv||camera_zoom_length!=4)return 0;
+        const int zooms[]={1,5,10};int zoom=zooms[value];
+        return prop_request_change_wait(PROP_LV_DISPSIZE,&zoom,4,1000)&&lv_dispsize==zoom;
+    }
+    if(SABOOOR_NATIVE_VIDEO_MENU)return 0;
+    if(camera_video_length!=20||camera_standard_length!=4||video_system_pal)return 0;
+    int mode[5];memcpy(mode,camera_mode,sizeof(mode));
+    int oldres=video_mode_resolution,oldfps=video_mode_fps;
+    int res=oldres, fps=oldfps;
+    if(e->priv==&resolution_choice)
+    {
+        res=value;
+        int idx=rate_index(fps);
+        if(!valid_rate(res,idx))fps=res==1?60:30;
+    }
+    else {
+        fps=camera_rates[value];
+        if(!valid_rate(res,value))res=fps==60?1:0;
+    }
+    /* NTSC only. Change the video standard exclusively through Canon MENU. */
+    if(res==oldres&&fps==oldfps){if(e->priv==&rate_choice)rate_choice=value;return 1;}
+    if(RECORDING)return 0;
+    mode[1]=res;mode[2]=fps;
+    if(res!=0){mode[0]=0;mode[4]=0;}
+    int ok=prop_request_change_wait(PROP_VIDEO_MODE,mode,20,1000);
+    if(!ok||video_mode_resolution!=res||video_mode_fps!=fps)return 0;
+    resolution_choice=res;rate_choice=e->priv==&rate_choice?value:rate_index(fps);
+    return 1;
+}
+/* Never wait for Canon properties in the GUI/key task or while holding menu_sem. */
+static void camera_apply_task(void *unused)
+{
+    int kind=camera_pending_kind,value=camera_pending_value;
+    gui_stop_menu();msleep(300);
+    struct menu_entry e={.priv=kind==0?&resolution_choice:kind==1?&rate_choice:&zoom_choice,.select=camera_select};
+    int oldres=video_mode_resolution;
+    int ok=!gui_menu_shown() && camera_apply(&e,value);
+    camera_pending=0;
+    if(!ok)NotifyBox(5000,"Video change not confirmed.\nCheck settings in Canon menu.");
+    else if(kind==1 && oldres!=video_mode_resolution)
+        NotifyBox(5000,value==4?"High Speed: 59.94 fps\nResolution changed to 1280x720.":"Frame rate selected.\nResolution changed to 1920x1080.");
+    else if(kind==1 && (value==1||value==3))
+        NotifyBox(4000,value==1?"24 selects Canon 23.976 fps.":"30 selects Canon 29.97 fps.");
+}
+int sabooor_camera_commit(struct menu_entry *e,int value)
+{
+    if(camera_pending||!sabooor_camera_staged(e)||!sabooor_camera_allowed(e,value)||RECORDING||!is_movie_mode()||get_config_var("fps.override"))return 0;
+    if(e->priv==&zoom_choice){if(!lv||camera_zoom_length!=4)return 0;}
+    else {
+        if(SABOOOR_NATIVE_VIDEO_MENU)return 0;
+        if(video_system_pal){NotifyBox(5000,"Select NTSC in Canon MENU > Video system first.");return 0;}
+        if(camera_video_length!=20||camera_standard_length!=4)return 0;
+    }
+    camera_pending_kind=e->priv==&resolution_choice?0:e->priv==&rate_choice?1:2;
+    camera_pending_value=value;camera_pending=1;
+    task_create("sab_video",0x1c,0x2000,camera_apply_task,0);
+    return 1;
+}
+static void camera_select(void *priv,int delta)
+{
+    struct menu_entry e={.priv=priv,.select=camera_select};
+    int base=priv==&resolution_choice?video_mode_resolution:priv==&zoom_choice?(lv_dispsize==10?2:lv_dispsize==5?1:0):rate_index(video_mode_fps);
+    int max=priv==&rate_choice?4:2;
+    for(int v=base+delta;v>=0&&v<=max;v+=delta)
+        if(sabooor_camera_allowed(&e,v)){sabooor_camera_commit(&e,v);break;}
+}
+static MENU_UPDATE_FUNC(film_display)
+{
+    if(EXT_MONITOR_CONNECTED)MENU_SET_WARNING(MENU_WARN_NOT_WORKING,"Fuji LUT preview: LCD only; recorded H.264 is unchanged.");
+    else if(film_error)MENU_SET_WARNING(MENU_WARN_NOT_WORKING,"LUT unavailable or unsupported LCD mode. Check ML/LOOKS.");
+    else MENU_SET_WARNING(MENU_WARN_ADVICE,"Preview only; does not change recorded H.264.");
+}
+int sabooor_film_enabled(void){return SABOOOR_ACTIVE&&sabooor_film>0&&sabooor_film<=3&&sabooor_film_strength>0&&sabooor_film_strength<=4;}
+static int load_film(void)
+{
+    if(film_lut&&film_loaded==sabooor_film)return 1;
+    if(film_lut){free(film_lut);film_lut=0;}film_loaded=0;film_error=0;
+    const char *paths[]={"","ML/LOOKS/provia.sab","ML/LOOKS/velvia.sab","ML/LOOKS/superia.sab"};
+    int size=0;unsigned *data=(unsigned*)read_entire_file(paths[sabooor_film],&size);
+    if(!data||size!=131088||data[0]!=0x46424153||data[1]!=1||data[2]!=32768)goto fail;
+    unsigned h=2166136261u;unsigned char *p=(unsigned char*)(data+4);
+    for(int i=0;i<131072;i++)h=(h^p[i])*16777619u;
+    if(h!=data[3])goto fail;
+    film_lut=data;film_loaded=sabooor_film;return 1;
+fail:
+    if(data)free(data);
+    film_error=1;return 0;
+}
+int sabooor_film_frame(void)
+{
+    if(!sabooor_film_enabled()||EXT_MONITOR_CONNECTED||!lv||!is_movie_mode())return 0;
+    if(!load_film()){set_config_var("sabooor.film",0);return 0;}
+    uint32_t *src,*dst;display_filter_get_buffers(&src,&dst);
+    int ok=sab_film_rows((unsigned*)dst,(unsigned*)src,film_lut+4,vram_lv.width,vram_lv.height,vram_lv.pitch,
+        sabooor_film_strength,get_config_var("anamorphic.preview"));
+    if(!ok){film_error=1;set_config_var("sabooor.film",0);}
+    return ok;
+}
+static void format_task(void *unused)
+{
+    if(RECORDING)return;
+    gui_stop_menu();msleep(200);SetGUIRequestMode(1);
+    NotifyBox(10000,"Canon MENU > Format card\nConfirm in Canon menu to erase photos.");
+}
+static MENU_SELECT_FUNC(format_open)
+{
+    if(!RECORDING)task_create("sab_format",0x1c,0x2000,format_task,0);
+}
+static struct menu_entry camera_menu[]={
+#if SABOOOR_NATIVE_VIDEO_MENU
+    {.name="Sabooor recording resolution",.priv=&resolution_choice,.max=2,.choices=CHOICES("1920x1080","1280x720","640x480"),.update=camera_display,.select=canon_video_open,.help="Open Canon Movie rec. size. No video-mode property writes by Sabooor."},
+    {.name="Sabooor project rate",.priv=&rate_choice,.max=4,.choices=CHOICES("23.976","24","29.97","30","59.94"),.update=camera_display,.select=canon_video_open,.help="Open Canon Movie rec. size for native cadence and ALL-I/IPB selection."},
+#else
+    {.name="Sabooor recording resolution",.priv=&resolution_choice,.max=2,.choices=CHOICES("1920x1080","1280x720","640x480"),.update=camera_display,.select=camera_select,.help="Canon mode. May change frame rate to a supported value."},
+    {.name="Sabooor project rate",.priv=&rate_choice,.max=4,.choices=CHOICES("23.976","24","29.97","30","59.94"),.update=camera_display,.select=camera_select,.help="NTSC rates. 24/30 are rounded aliases; 59.94 switches to 720p."},
+#endif
+    {.name="Sabooor Fuji LUT",.priv=&sabooor_film,.max=3,.choices=CHOICES("OFF / Canon","Fuji Provia 100F","Fuji Velvia 50","Fuji Superia X400"),.update=film_display,.help="LCD preview-only film emulations. Not official Fujifilm simulations."},
+    {.name="Sabooor LUT intensity",.priv=&sabooor_film_strength,.max=4,.choices=CHOICES("0%","25%","50%","75%","100%"),.help="Mix film preview with the original display image."},
+    {.name="Sabooor frame ratio",.priv=&sabooor_frame_ratio,.max=3,.choices=CHOICES("1.78:1 (16:9)","2.35:1","1:1","9:16"),.help="Frame guides only; recorded dimensions stay unchanged."},
+    {.name="Sabooor next reel",.priv=&sabooor_reel_next,.min=1,.max=999,.help="Project counter stored in ML settings; does not rename Canon clips."},
+    {.name="Sabooor magnification",.priv=&zoom_choice,.max=2,.choices=CHOICES("1x","5x","10x"),.update=camera_display,.select=camera_select,.help="Canon LCD magnification. Stop recording before changing zoom."},
+    {.name="Sabooor format card",.select=format_open,.icon_type=IT_ACTION,.help="Open Canon menu. Select Format card there; Canon confirmation is required."}
+};
+static void camera_init(void *unused){menu_add("Prefs",camera_menu,COUNT(camera_menu));}
+INIT_FUNC(__FILE__,camera_init);
+#endif
