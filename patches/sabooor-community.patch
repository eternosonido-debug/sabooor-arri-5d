+static struct menu_entry *sab_node_entry(int node)
+{
+    if (node<0 || node>=SAB_NODE_COUNT || !sab_nodes[node].entry) return 0;
+    if ((sab_nodes[node].flags&1) && !get_config_var("audio.override_audio")) return 0;
+    if ((sab_nodes[node].flags&8) && get_config_var("audio.alc-enable")) return 0;
+    if ((sab_nodes[node].flags&4) && !get_config_var("fps.override")) return 0;
+    for (struct menu *m=menus; m; m=m->next)
+        if (streq(m->name,sab_nodes[node].menu))
+            for (struct menu_entry *e=m->children; e; e=e->next)
+                if (streq(e->name,sab_nodes[node].entry)) return e;
+    return 0;
+}
