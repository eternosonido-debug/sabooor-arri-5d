+        return 1;
+    }
+    if (sab_nodes[node].readout) { give_semaphore(menu_sem); return 1; }
+    struct menu_entry *e=sab_node_entry(node);
+    if (!e || !sab_bind_select(e)) { give_semaphore(menu_sem); return 1; }
+    if (sab_can_stage(e))
+    {
+        sab_choice_node=node; sab_choice_entry=e;
+        sab_choice_original=sab_choice_value=MENU_INT(e);
