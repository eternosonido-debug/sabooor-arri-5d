diff --git a/src/sabooor-film-render.h b/src/sabooor-film-render.h
new file mode 100644
index 0000000..92067f0
--- /dev/null
+++ b/src/sabooor-film-render.h
@@ -0,0 +1,30 @@
+/* GPL-2.0-or-later. Pure signed-chroma UYVY preview transform; never encoder buffers. */
+static unsigned sab_film_pixel(unsigned p, const unsigned *lut, int strength)
+{
+    int u=(signed char)p, v=(signed char)(p>>16);
+    int y0=(p>>8)&255, y1=p>>24;
+    unsigned index=(((p&255)>>3)<<5)|(((p>>16)&255)>>3);
+    unsigned a=lut[((y0>>3)<<10)|index], b=lut[((y1>>3)<<10)|index];
+    int q0=COERCE((int)(a&255)+(y0&7)-4,0,255);
+    int q1=COERCE((int)(b&255)+(y1&7)-4,0,255);
+    int qu=((int)(signed char)(a>>8)+(int)(signed char)(b>>8))/2;
+    int qv=((int)(signed char)(a>>16)+(int)(signed char)(b>>16))/2;
+    y0+=(q0-y0)*strength/4; y1+=(q1-y1)*strength/4;
+    u+=(qu-u)*strength/4; v+=(qv-v)*strength/4;
+    return ((unsigned)u&255)|((unsigned)y0<<8)|(((unsigned)v&255)<<16)|((unsigned)y1<<24);
+}
+static int sab_film_rows(unsigned *dst,const unsigned *src,const unsigned *lut,
+    int width,int height,int pitch,int strength,int squeeze)
+{
+    if (!dst||!src||!lut||dst==src||width!=720||height!=480||pitch!=1440||strength<0||strength>4||squeeze<0||squeeze>7) return 0;
+    const int num[]={1,5,4,7,3,5,9,2},den[]={1,4,3,5,2,3,5,1};
+    for (int y=0;y<480;y++)
+    {
+        int sy=(y-240)*num[squeeze]/den[squeeze]+240;
+        unsigned *d=dst+y*360;
+        if(sy<0||sy>=480){memset(d,0,1440);continue;}
+        const unsigned *s=src+sy*360;
+        for(int x=0;x<360;x++)d[x]=sab_film_pixel(s[x],lut,strength);
+    }
+    return 1;
+}
