+#!/bin/sh
+# GPL-2.0-or-later. Native build for 600D / Canon 1.0.2.
+set -eu
+: "${ARM_BINPATH:?Set ARM_BINPATH to the directory containing arm-none-eabi-gcc}"
+ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+case $(uname -s) in
+    Darwin) STAT_TOOL='stat -f %N:%z' ;;
+    *) STAT_TOOL='stat -c %n:%s' ;;
+esac
+make -C "$ROOT/platform/600D.102" \
+    ARM_BINPATH="$ARM_BINPATH" READELF="$ARM_BINPATH/arm-none-eabi-readelf" \
+    "STAT_CMD=$STAT_TOOL" CONFIG_QEMU= "$@"
+
+if [ -f "$ROOT/platform/600D.102/build/location.map" ]; then
+    python3 "$ROOT/tools/check-600d-memory.py"
+fi
diff --git a/tools/check-600d-memory.py b/tools/check-600d-memory.py
new file mode 100644
index 0000000..8a38023
--- /dev/null
+++ b/tools/check-600d-memory.py
@@ -0,0 +1,9 @@
+"""600D.102 cache-hack pool ends at 0xD00000 (Canon ROM mov r1,#0xD00000)."""
+from pathlib import Path
+import re,sys
+root=Path(__file__).resolve().parents[1]
+s=(Path(sys.argv[1]) if len(sys.argv)>1 else root/'platform/600D.102/build/location.map').read_text()
+end=int(re.search(r'0x([0-9a-f]+)\s+_bss_end\s*=',s)[1],16)
+margin=0xd00000-end
+if margin<0:raise SystemExit(f'FAIL: 600D reserved memory exceeded by {-margin} bytes; do not install')
+print(f'PASS: 600D reserved-memory margin {margin} bytes')
