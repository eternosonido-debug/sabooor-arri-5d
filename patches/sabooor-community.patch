index 0000000..8a7d4e8
--- /dev/null
+++ b/tools/make-sabooor-fuji.py
@@ -0,0 +1,39 @@
+"""Generate preview-only Fuji LUTs from JanLohse/spectral_film_lut (MIT).
+Usage: PYTHONPATH=/path/to/spectral_film_lut/src python this_script.py output_dir
+Input/output approximation: display-referred sRGB, Canon ML full-range signed-U/V BT.601.
+No claim of calibrated film matching, Fujifilm camera simulations or H.264 processing.
+"""
+from pathlib import Path
+import sys,struct,hashlib,json,subprocess
+import numpy as np
+import colour
+from spectral_film_lut import FUJI_PROVIA_100F,FUJI_VELVIA_50,FUJI_SUPERIA_XTRA_400,FUJI_CA_PRO_PDII
+from spectral_film_lut.film_spectral import FilmSpectral
+from spectral_film_lut.utils import film_conversion,create_lut
+out=Path(sys.argv[1]);out.mkdir(parents=True,exist_ok=True)
+y,u,v=np.meshgrid(np.arange(32)*8+4,np.arange(32)*8+4,np.arange(32)*8+4,indexing='ij')
+u=np.where(u>=128,u-256,u);v=np.where(v>=128,v-256,v)
+rgb=np.clip(np.stack([y+1.403*v,y-.344*u-.714*v,y+1.773*u],axis=-1)/255,0,1)
+profiles=[('provia',FUJI_PROVIA_100F),('velvia',FUJI_VELVIA_50),('superia',FUJI_SUPERIA_XTRA_400)]
+manifest={'source':'https://github.com/JanLohse/spectral_film_lut','source_commit':subprocess.check_output(['git','-C',str(Path(__import__('spectral_film_lut').__file__).resolve().parents[2]),'rev-parse','HEAD'],text=True).strip(),'license':'MIT','input':'sRGB display approximation / signed-chroma BT.601','purpose':'LCD preview; does not process recorded H.264','profiles':[]}
+for name,data in profiles:
+ print('Generating',data.name,flush=True)
+ film=FilmSpectral(data);film.set_color_checker()
+ paper=None
+ if data.film_type=='negative':paper=FilmSpectral(FUJI_CA_PRO_PDII);paper.set_color_checker(negative=film)
+ kwargs=dict(input_colorspace='sRGB',output_gamut='Rec. 709',gamma_func='sRGB')
+ graded=np.clip(film_conversion(rgb.copy(),film,paper,**kwargs),0,1)*255
+ assert graded.shape==rgb.shape and np.isfinite(graded).all()
+ r,g,b=np.moveaxis(graded,-1,0)
+ yy=np.rint(.299*r+.587*g+.114*b).clip(0,255).astype(np.uint32)
+ uu=(np.rint(-.168736*r-.331264*g+.5*b).clip(-128,127).astype(np.int32)&255).astype(np.uint32)
+ vv=(np.rint(.5*r-.418688*g-.081312*b).clip(-128,127).astype(np.int32)&255).astype(np.uint32)
+ payload=(yy|(uu<<8)|(vv<<16)).astype('<u4').tobytes();checksum=2166136261
+ for c in payload:checksum=((checksum^c)*16777619)&0xffffffff
+ blob=struct.pack('<4sIII',b'SABF',1,32768,checksum)+payload
+ (out/(name+'.sab')).write_bytes(blob)
+ table=create_lut(film,paper,lut_size=17,cube=False,**kwargs)
+ colour.io.write_LUT(colour.LUT3D(table=table,name='Sabooor Fuji '+name),str(out/(name+'.cube')))
+ manifest['profiles'].append({'name':data.name,'file':name+'.sab','sha256':hashlib.sha256(blob).hexdigest()})
+(out/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
+print('Generated and validated',len(profiles),'profiles',flush=True)
