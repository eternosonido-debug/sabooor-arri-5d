diff --git a/tests/sabooor/render.py b/tests/sabooor/render.py
new file mode 100644
index 0000000..71ddf2d
--- /dev/null
+++ b/tests/sabooor/render.py
@@ -0,0 +1,50 @@
+"""Render actual drawing commands with ML's bundled RBF glyphs (Pillow)."""
+import sys, struct, subprocess
+from pathlib import Path
+from PIL import Image
+root=Path(__file__).resolve().parents[2]
+out=Path(sys.argv[1]);out.mkdir(parents=True,exist_ok=True)
+fonts=[]
+for name in ['term12','argnor23','argnor32','sabo12','sabo16b']:
+    b=(root/'data/fonts'/f'{name}.rbf').read_bytes()
+    h=struct.unpack_from('<11i',b,72)
+    size,points,height,width,first,last,unk,wo,co,desc,line=h
+    fonts.append((b,size,height,first,last,wo,co))
+colors={0:(12,15,18),1:(235,240,242),5:(80,210,225),8:(240,65,65),9:(70,230,80),50:(70,75,79),66:(160,160,160)}
+for mode,name in enumerate(['monitor','home','recording','unavailable','menu-schematic','guides','shutter-time','edge-values']):
+    commands=subprocess.check_output([str(out/'render-test'),str(mode)]).decode('latin1')
+    (out/f'{name}.commands').write_text(commands)
+    im=Image.new('RGB',(720,480),(38,47,51))
+    for row in commands.splitlines():
+        a=row.split('\t'); kind=a[0]
+        if kind in ('F','R'):
+            c,x,y,w,h=map(int,a[1:]);rgb=colors[c]
+            if kind=='F': im.paste(rgb,(x,y,x+w,y+h))
+            else:
+                from PIL import ImageDraw
+                ImageDraw.Draw(im).rectangle((x,y,x+w,y+h),outline=rgb)
+        else:
+            f,x,y=map(int,a[1:4]);text=a[4];rgb=colors[(f>>8)&255];bg=colors[(f>>16)&255]
+            b,size,height,first,last,wo,co=fonts[f&255]
+            start=x
+            for ch in text:
+                code=ord(ch); assert first<=code<=last
+                cw=b[wo+code-first]; stride=size//height
+                assert x+cw<=720 and y+height<=480, (name,text,x,cw,y,height)
+                data=co+(code-first)*size
+                if not (name=='menu-schematic' and y==90): im.paste(bg,(x,y,x+cw,y+height))
+                for yy in range(height):
+                    for xx in range(cw):
+                        if b[data+yy*stride+xx//8] & (1<<(xx%8)):
+                            im.putpixel((x+xx,y+yy),rgb)
+                x+=cw
+            if name in ('monitor','recording','guides','shutter-time','edge-values') and y in (22,443):
+                limits={61:128,183:246,275:352,378:442,538:720,59:134,162:227,260:362,376:465,503:601}
+                if start in limits: assert x<=limits[start], (name,text,start,x,limits[start])
+    if mode==1: assert '24.000' in commands and '5600K' in commands and '172.8' in commands
+    if mode==2: assert '\tREC' in commands and '\tHOME' not in commands
+    if mode==5: assert 'R\t1\t54\t60\t644\t362' in commands
+    if mode==6: assert '1/50' in commands
+    if mode==3: assert 'AUTO' in commands and 'AWB' in commands and '--' in commands
+    im.save(out/f'{name}.png')
+print('PASS: eight scenarios; glyph/shape and column bounds; angle/time shutter formats; guide toggle; HOME/REC fallback; unavailable and edge metadata.')
