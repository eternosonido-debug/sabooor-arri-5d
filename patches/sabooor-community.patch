+        if (!sab_content_focus && !sab_home)
+        {
+            sab_category=COERCE(sab_category+delta,0,10);
+            sab_parent=-1; sab_row=0;
+        }
+        else
+        {
+            int total=0; sab_child(category,sab_parent,-1,&total);
+            sab_row=COERCE(sab_row+delta,0,MAX(0,total-1));
+        }
+        return 1;
+    }
+    if (key!=BGMT_PRESS_SET && key!=BGMT_PRESS_RIGHT && key!=BGMT_Q) return 0;
+    if (!sab_content_focus && !sab_home) { sab_content_focus=1; return 1; }
+    take_semaphore(menu_sem,0);
