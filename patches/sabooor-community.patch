+TARGET=${1:?Usage: build-sabooor-community.sh 5D3.113|5D3.123|600D.102 [make options]}
+shift
+case "$TARGET" in 5D3.113|5D3.123|600D.102) ;; *) echo "Unreviewed target: $TARGET" >&2;exit 1;; esac
+case $(uname -s) in Darwin) STAT_TOOL='stat -f %N:%z';; *) STAT_TOOL='stat -c %n:%s';; esac
+make -C "$ROOT/platform/$TARGET" ARM_BINPATH="$ARM_BINPATH" READELF="$ARM_BINPATH/arm-none-eabi-readelf" "STAT_CMD=$STAT_TOOL" CONFIG_QEMU= "$@"
