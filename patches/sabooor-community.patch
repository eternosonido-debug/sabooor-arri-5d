@@ -0,0 +1,21 @@
+"""Compile the reviewed ARRI chart transcription into an immutable UI tree."""
+from pathlib import Path
+import json
+root=Path(__file__).resolve().parents[1]
+providers=['codec','sensor','resolution','project_rate','sound','version','system','media','lens','actual_fps','exposure_time','camera_index','canon_button']
+spec=json.loads((root/'data/sabooor/menu-map.json').read_text());rows=[]
+def walk(nodes,parent,cat):
+ for node in nodes:
+  idx=len(rows);bind=node.get('binding',{})
+  rows.append((node['label'],bind.get('menu'),bind.get('entry'),parent,cat,int('children' in node),providers.index(node['readout'])+1 if node.get('readout') else 0,node.get('flags',0)))
+  walk(node.get('children',[]),idx,cat)
+for cat,nodes in enumerate(spec['sections'].values()):walk(nodes,-1,cat)
+assert len(rows)<512 and all(r[6]<16 and r[7]<32 for r in rows)
+q=lambda v:json.dumps(v) if v is not None else '0'
+text='/* Generated from data/sabooor/menu-map.json. ARRI SUP 1.1 structure. */\n'
+text+='struct sab_map_node { const char *label, *menu, *entry; signed int parent:10; unsigned int category:4, group:1, readout:4, flags:5; };\n'
+text+='static const struct sab_map_node sab_nodes[] = {\n'
+text+=''.join('    {'+', '.join([q(label),q(menu),q(entry),str(parent),str(cat),str(group),str(readout),str(flags)])+'},\n' for label,menu,entry,parent,cat,group,readout,flags in rows)
+text+='};\n#define SAB_NODE_COUNT '+str(len(rows))+'\n'
+(root/'src/sabooor-menu-map.h').write_text(text)
+print('Immutable menu nodes:',len(rows))
