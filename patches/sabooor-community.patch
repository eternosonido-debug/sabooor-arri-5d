+        if (!sab_choice_present()) { sab_choice_entry=0; give_semaphore(menu_sem); return 1; }
+        struct menu_entry *e=sab_choice_entry;
+        if (key==BGMT_MENU || key==BGMT_Q || key==BGMT_TRASH) sab_choice_entry=0;
+        else if (key==BGMT_PRESS_UP || key==BGMT_WHEEL_UP)
+            sab_choice_move(-1);
+        else if (key==BGMT_PRESS_DOWN || key==BGMT_WHEEL_DOWN)
+            sab_choice_move(1);
+        else if (key==BGMT_PRESS_SET)
+        {
+            if (sab_node_entry(sab_choice_node)==e && sab_can_stage(e) && MENU_INT(e)==sab_choice_original &&
+                sab_choice_allowed(e,sab_choice_value))
+            {
+                if (MENU_INT(e)!=sab_choice_value)
+                {
+                    if (sabooor_camera_staged(e)?sabooor_camera_commit(e,sab_choice_value):set_config_var_ptr(e->priv,sab_choice_value))
+                    {
+                        config_dirty=1; mod_menu_dirty=1;
+                        menu_update_usage_counters(e);
+                    }
+                    else beep();
+                }
+            }
+            else beep();
+            sab_choice_entry=0;
+        }
+        give_semaphore(menu_sem);
+        return 1;
+    }
+    /* Deliberate escape hatch for complete native ML; no extra map item. */
+    if (key==BGMT_INFO) { sab_native_page=1; return 1; }
+    if (key==BGMT_PLAY)
+    {
+        sab_home=(sab_home+1)%3; sab_parent=-1; sab_row=0;
+        sab_content_focus=sab_home; submenu_level=0;
+        return 1;
+    }
+    if (key==BGMT_MENU || (key==BGMT_PRESS_LEFT && !(sab_home==1 && sab_parent<0)))
+    {
+        if (!sab_home && sab_parent<0 && !sab_content_focus) return 0;
+        sab_tree_back();
+        return 1;
+    }
+    int category=sab_home==2?12:sab_home?11:sab_category;
+    int delta=(key==BGMT_PRESS_UP || key==BGMT_WHEEL_UP)?-1:
+        (key==BGMT_PRESS_DOWN || key==BGMT_WHEEL_DOWN)?1:0;
+    if (sab_home==1 && sab_parent<0)
+    {
+        delta*=3;
+        if (key==BGMT_PRESS_LEFT) delta=-1;
+        if (key==BGMT_PRESS_RIGHT) delta=1;
+    }
+    if (delta)
